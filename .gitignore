# build output
out/
*.log

# secrets — never commit
server/cnfg.json
cookie.txt
refract-session.txt
*.pem

# runtime artifacts
pw-profile/
server/join-dump.json
server/englog-dump.txt
server/wt-stats.json
server/cache/
server/__pycache__/
_archive/

# session/debug dumps
*.bin
*.hex
*.png
shots/
netlog.json
flags.json
status-log.json

# vendored QUIC dep trees for the shelved native relay — re-clone per build
server/native/

# engine decomp — regenerated by tools/ (see core/src/engine/README.md)
core/src/engine/funcs/
core/src/engine/src/
core/src/engine/csrc/
core/src/engine/*.wat
core/src/engine/*.wasm
core/src/engine/*.dcmp.c
core/src/engine/sec_*.wat
core/src/engine/funcs.index.tsv

# Roblox binaries / staged payload (supply your own)
core/staging/WebClient.wasm
core/staging/**/*.wasm
node_modules/
core/js/_upstream.js
# engine dump content — acquire via scripts/fetch-engine.mjs + sync-staging.mjs;
# never commit upstream binaries or content assets
core/staging/*
!core/staging/WebClient.metadata.json
!core/staging/content-metadata.json
server/map.json
server/inexperience.rbxm.gz

# sqlite database + journals
server/data/
